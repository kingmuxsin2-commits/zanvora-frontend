{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/supplier/layout,_N_T_/supplier/pending/layout,_N_T_/supplier/pending/page,_N_T_/supplier/pending"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/supplier/pending/__PAGE__",
    "/supplier/pending",
    "/supplier",
    "/_index",
    "/_head"
  ]
}