{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/order/layout,_N_T_/order/payment/layout,_N_T_/order/payment/page,_N_T_/order/payment"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/order/payment/__PAGE__",
    "/order/payment",
    "/order",
    "/_index",
    "/_head"
  ]
}